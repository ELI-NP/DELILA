          <confFile>/tmp/daqmw/rtc.conf</confFile>
          <startOrd>3</startOrd>
          <inPorts>
	    <inPort from="ReaderPSD0:reader_out">dispatcher_in1</inPort>
	    <inPort from="ReaderN0:reader_out">dispatcher_in2</inPort>
