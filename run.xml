          <execPath>/home/daq/DELILA/Components/ReaderPSD/ReaderPSDComp</execPath>
          <confFile>/tmp/daqmw/rtc.conf</confFile>
          <startOrd>4</startOrd>
          <inPorts>
          </inPorts>
          <outPorts>
            <outPort>reader_out</outPort>
          </outPorts>
          <params>
	    <param pid="StartModNo">2</param>
	    <param pid="ConfigFile">/home/daq/DELILA/E9/PSD.conf</param>
